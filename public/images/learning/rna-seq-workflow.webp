" data-clip="true" data-dimension="height" style="--tg-will-change: auto; --tg-enter-opacity: 1; --tg-enter-transform: none; --tg-enter-filter: none; --tg-enter-duration: 300ms; --tg-enter-delay: 0ms; --tg-enter-timing-function: ease-in-out; --tg-exit-opacity: 0; --tg-exit-transform: none; --tg-exit-filter: none; --tg-exit-duration: 300ms; --tg-exit-delay: 0ms; --tg-exit-timing-function: ease-in-out; --tg-initial-opacity: 0; --tg-initial-transform: none; --tg-initial-filter: none; --tg-layout-enter-duration: 300ms; --tg-layout-enter-delay: 0ms; --tg-layout-enter-timing-function: ease-in-out; --tg-layout-exit-duration: 300ms; --tg-layout-exit-delay: 0ms; --tg-layout-exit-timing-function: ease-in-out; --tg-layout-move-duration: 300ms; --tg-layout-move-delay: 0ms; --tg-layout-move-timing-function: var(--cubic-move);"><div class="fKQ0lq_TransitionItem WlXitW_TransitionGroupChild"><div class="select-none active:select-auto data-has-range-start:select-auto"><button type="button" class="flex items-center gap-1 text-start select-none text-token-text-tertiary dark:text-(--interactive-label-tertiary-default) hover:text-token-text-primary dark:hover:text-token-text-primary" aria-expanded="false">Worked for 56s<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" data-rtl-flip="" class="icon-sm transition-transform"><use href="/cdn/assets/sprites-core-0beb1f83.svg#07889e" fill="currentColor"></use></svg></button><div class="fKQ0lq_Layout w-full" data-item-anchor="start" data-clip="true" data-dimension="height" style="--tg-will-change: auto; --tg-enter-opacity: 1; --tg-enter-transform: none; --tg-enter-filter: none; --tg-enter-duration: 300ms; --tg-enter-delay: 0ms; --tg-enter-timing-function: ease-in-out; --tg-exit-opacity: 0; --tg-exit-transform: none; --tg-exit-filter: none; --tg-exit-duration: 300ms; --tg-exit-delay: 0ms; --tg-exit-timing-function: ease-in-out; --tg-initial-opacity: 0; --tg-initial-transform: none; --tg-initial-filter: none; --tg-